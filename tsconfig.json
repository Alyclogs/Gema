{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": [
			"ES2020",
			"DOM"
		],
		"skipLibCheck": true,
		"allowJs": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"enviroment.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"web"
	]
}
